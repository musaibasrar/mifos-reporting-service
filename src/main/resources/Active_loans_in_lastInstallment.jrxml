	<parameter name="officeId" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
    -- Indentation Fix: Ensured proper CONCAT syntax
    CONCAT(REPEAT('..', 
        (LENGTH(lastInstallment.hierarchy) - LENGTH(REPLACE(lastInstallment.hierarchy, '.', '')) - 1))) AS hierarchyIndent,
    lastInstallment.branch AS "Office/Branch",
    
    lastInstallment.Currency,
    lastInstallment.`Loan Officer`,
    lastInstallment.`Client Account No`,
    lastInstallment.Client,
    lastInstallment.`Loan Account No`,
    lastInstallment.Product,
    lastInstallment.Fund,
    lastInstallment.`Loan Amount`,
    lastInstallment.`Annual Nominal Interest Rate`,
    lastInstallment.Disbursed,
    lastInstallment.`Expected Matured On`,

    -- Loan Principal Details
    l.principal_repaid_derived AS "Principal Repaid",
    l.principal_outstanding_derived AS "Principal Outstanding",
    laa.principal_overdue_derived AS "Principal Overdue",

    -- Interest Details
    l.interest_repaid_derived AS "Interest Repaid",
    l.interest_outstanding_derived AS "Interest Outstanding",
    laa.interest_overdue_derived AS "Interest Overdue",

    -- Fee Charges
    l.fee_charges_repaid_derived AS "Fees Repaid",
    l.fee_charges_outstanding_derived AS "Fees Outstanding",
    laa.fee_charges_overdue_derived AS "Fees Overdue",

    -- Penalty Charges
    l.penalty_charges_repaid_derived AS "Penalties Repaid",
    l.penalty_charges_outstanding_derived AS "Penalties Outstanding",
    laa.penalty_charges_overdue_derived AS "Penalties Overdue"

FROM 
    (SELECT 
        l.id AS loanId,
        l.number_of_repayments,
        MIN(r.installment) AS min_installment, -- ✅ Correct alias for aggregation
        o.id AS office_id,
        o.hierarchy,
        o.name AS branch,
        IFNULL(cur.display_symbol, l.currency_code) AS Currency,
        lo.display_name AS `Loan Officer`,
        c.account_no AS `Client Account No`,
        c.display_name AS Client,
        l.account_no AS `Loan Account No`,
        pl.name AS Product,
        f.name AS Fund,
        l.principal_amount AS `Loan Amount`,
        l.annual_nominal_interest_rate AS `Annual Nominal Interest Rate`,
        DATE(l.disbursedon_date) AS Disbursed,
        DATE(l.expected_maturedon_date) AS `Expected Matured On`
    
    FROM m_office o
    JOIN m_client c ON c.office_id = o.id
    JOIN m_loan l ON l.client_id = c.id
    JOIN m_product_loan pl ON pl.id = l.product_id
    LEFT JOIN m_staff lo ON lo.id = l.loan_officer_id
    LEFT JOIN m_currency cur ON cur.code = l.currency_code
    LEFT JOIN m_fund f ON f.id = l.fund_id
    LEFT JOIN m_loan_repayment_schedule r ON r.loan_id = l.id
    
    WHERE 
        o.id = $P{officeId}  
        AND (l.currency_code = $P{currencyId} OR '-1' = $P{currencyId})
        AND (l.product_id = $P{loanProductId} OR '-1' = $P{loanProductId})
        AND (IFNULL(l.loan_officer_id, -10) = $P{loanOfficerId} OR '-1' = $P{loanOfficerId})
        AND l.loan_status_id = 300
        AND r.completed_derived = FALSE
        AND r.duedate >= CURDATE()

    GROUP BY 
        l.id, o.id, o.hierarchy, o.name, cur.display_symbol, lo.display_name, 
        c.account_no, c.display_name, l.account_no, pl.name, f.name, l.principal_amount, 
        l.annual_nominal_interest_rate, l.disbursedon_date, l.expected_maturedon_date

    HAVING MIN(r.installment) = l.number_of_repayments -- ✅ Fixed HAVING syntax
    ) lastInstallment

JOIN m_loan l ON l.id = lastInstallment.loanId
LEFT JOIN m_loan_arrears_aging laa ON laa.loan_id = l.id

ORDER BY 
    lastInstallment.hierarchy, 
    lastInstallment.Currency, 
    lastInstallment.`Client Account No`, 
    lastInstallment.`Loan Account No`;
]]></query>
