		<parameter name="endDate" class="java.sql.Date"/>
		<parameter name="officeId" class="java.lang.Integer"/>
		<query language="sql"><![CDATA[SELECT * FROM (
    -- ASSETS
    SELECT debits.glcode AS glcode, debits.name AS name, 'Assets' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 1
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    LEFT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 1
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    SELECT credits.glcode AS glcode, credits.name AS name, 'Assets' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 1
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    RIGHT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 1
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    -- LIABILITIES
    SELECT debits.glcode AS glcode, debits.name AS name, 'Liability' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 2
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    LEFT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 2
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    SELECT credits.glcode AS glcode, credits.name AS name, 'Liability' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 2
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    RIGHT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 2
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    -- EQUITY
    SELECT debits.glcode AS glcode, debits.name AS name, 'Equity' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 3
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    LEFT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 3
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    SELECT credits.glcode AS glcode, credits.name AS name, 'Equity' AS BalanceType,
           (IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0)) AS balance
    FROM (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS debitamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 2
          AND acc_gl_account.classification_enum = 3
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    RIGHT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode, name, SUM(amount) AS creditamount
        FROM acc_gl_journal_entry, acc_gl_account
        WHERE acc_gl_account.id = acc_gl_journal_entry.account_id
          AND acc_gl_journal_entry.type_enum = 1
          AND acc_gl_account.classification_enum = 3
          AND acc_gl_journal_entry.entry_date <= DATE($P{endDate})
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode
) result
ORDER BY glcode;
]]></query>
