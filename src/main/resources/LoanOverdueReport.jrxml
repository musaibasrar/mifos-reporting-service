	<dataset name="Dataset1" uuid="e5969a75-fa56-4a28-91d9-bf0a9cd36652">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<parameter name="officeId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{officeId}]]></defaultValueExpression>
		</parameter>
		<parameter name="loanOfficerId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{loanOfficerId}]]></defaultValueExpression>
		</parameter>
		<parameter name="fromX" class="java.util.Date">
			<defaultValueExpression><![CDATA[$P{fromX}]]></defaultValueExpression>
		</parameter>
		<parameter name="toY" class="java.util.Date">
			<defaultValueExpression><![CDATA[$P{toY}]]></defaultValueExpression>
		</parameter>
		<parameter name="overdueX" class="java.util.Date">
			<defaultValueExpression><![CDATA[$P{overdueX}]]></defaultValueExpression>
		</parameter>
		<parameter name="overdueY" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{overdueY}]]></defaultValueExpression>
		</parameter>
		<query language="SQL"><![CDATA[SELECT 
    mc.id AS "id",
    mc.firstname AS "firstName",
    mc.middlename AS "middleName",
    mc.lastname AS "lastName",
    mc.display_name AS "fullName",
    mc.mobile_no AS "mobileNo",
    ml.principal_amount AS "loanAmount",
    (IFNULL(ml.principal_outstanding_derived, 0) + 
     IFNULL(ml.interest_outstanding_derived, 0) + 
     IFNULL(ml.fee_charges_outstanding_derived, 0) + 
     IFNULL(ml.penalty_charges_outstanding_derived, 0)) AS "loanOutstanding",
    ml.principal_disbursed_derived AS "loanDisbursed",
    laa.overdue_since_date_derived AS "paymentDueDate",
    (IFNULL(SUM(ls.principal_amount), 0) - 
     IFNULL(SUM(ls.principal_writtenoff_derived), 0) +
     IFNULL(SUM(ls.interest_amount), 0) - 
     IFNULL(SUM(ls.interest_writtenoff_derived), 0) - 
     IFNULL(SUM(ls.interest_waived_derived), 0) +
     IFNULL(SUM(ls.fee_charges_amount), 0) - 
     IFNULL(SUM(ls.fee_charges_writtenoff_derived), 0) - 
     IFNULL(SUM(ls.fee_charges_waived_derived), 0) +
     IFNULL(SUM(ls.penalty_charges_amount), 0) - 
     IFNULL(SUM(ls.penalty_charges_writtenoff_derived), 0) - 
     IFNULL(SUM(ls.penalty_charges_waived_derived), 0)
    ) AS "totalDue",
    laa.total_overdue_derived AS "totalOverdue",
    ounder.id AS "officeNumber",
    ml.account_no AS "loanAccountId",
    gua.lastname AS "guarantorLastName",
    COUNT(gua.id) AS "numberOfGuarantors",
    g.display_name AS "groupName"
FROM m_office mo
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(mo.hierarchy, '%')
INNER JOIN m_client mc ON mc.office_id = ounder.id
INNER JOIN m_loan ml ON ml.client_id = mc.id
INNER JOIN r_enum_value rev ON rev.enum_id = ml.loan_status_id AND rev.enum_name = 'loan_status_id'
INNER JOIN m_loan_arrears_aging laa ON laa.loan_id = ml.id
LEFT JOIN m_loan_repayment_schedule ls ON ls.loan_id = ml.id
LEFT JOIN m_currency cur ON cur.code = ml.currency_code
LEFT JOIN m_group_client gc ON gc.client_id = mc.id
LEFT JOIN m_group g ON g.id = gc.group_id
LEFT JOIN m_staff lo ON lo.id = ml.loan_officer_id
LEFT JOIN m_guarantor gua ON gua.loan_id = ml.id
WHERE ml.loan_status_id = 300
AND mo.id = $P{officeId} 
AND (IFNULL(ml.loan_officer_id, -10) = $P{loanOfficerId} OR '-1' = $P{loanOfficerId})
AND (DATEDIFF(CURDATE(), ls.duedate) BETWEEN $P{fromX} AND $P{toY})
AND (DATEDIFF(CURDATE(), laa.overdue_since_date_derived) BETWEEN $P{overdueX} AND $P{overdueY})
GROUP BY ml.id
ORDER BY ounder.hierarchy, ml.currency_code, mc.account_no, ml.account_no
]]></query>
