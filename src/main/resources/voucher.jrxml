<jasperReport name="VoucherReceipt" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6f3b1c52-4581-47ae-8be6-e0c29f2f4ba3">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="voucher_id" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
    je.transaction_id,
    je.entry_date,
    je.type_enum,
    je.amount,
    je.account_id,
    je.description,
    COALESCE(pd.check_number, 'NA') AS cheque_no,
    pd.bank_number AS bank_no,
    coa.name AS account_name
FROM acc_gl_journal_entry je
LEFT JOIN acc_gl_account coa ON je.account_id = coa.id
LEFT JOIN m_payment_detail pd 
    ON je.payment_details_id = pd.id
WHERE je.transaction_id = $P{voucher_id}
 ORDER BY je.id ASC
]]></query>
