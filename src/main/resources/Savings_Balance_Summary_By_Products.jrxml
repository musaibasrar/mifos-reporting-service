	<dataset name="SavingsBalanceByProductDataset" uuid="26081e57-e14c-4a35-a9c5-bc59040b99ab">
		<property name="com.jaspersoft.studio.data.sql.tables" value="bV9zYXZpbmdzX2FjY291bnQgLDE0OCwxNSwzYzExYzViYS05YjMwLTQyMDktYmUwOS02NjFmMGRh&#xa;YzA2Zjk7bV9zYXZpbmdzX3Byb2R1Y3QgLDQwOSwxNSxlOTQ4Nzc0Yi0xZWI0LTQ1NzEtYmY0ZC00&#xa;NDhlOTNmMTMwZjM7bV9jbGllbnQgLDE1LDE1LGIwMWM2M2MzLTU5ODUtNDM0My04MmEzLWRmYWUw&#xa;YTJiNDkzNDs="/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<parameter name="officeId" class="java.lang.Integer"/>
		<query language="SQL"><![CDATA[SELECT 
  savingproduct.short_name AS shortname,
  savingproduct.name AS fullname,
  SUM(savingaccount.account_balance_derived) AS balanceamount
FROM m_savings_account savingaccount
LEFT JOIN m_savings_product savingproduct 
  ON savingproduct.id = savingaccount.product_id
LEFT JOIN m_client client 
  ON client.id = savingaccount.client_id
WHERE savingaccount.status_enum = 300 
  AND (client.office_id = $P{officeId} OR $P{officeId} = 1)
GROUP BY savingaccount.product_id
ORDER BY balanceamount DESC
]]></query>
		<field name="shortname" class="java.lang.String">
