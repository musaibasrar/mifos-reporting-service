		</field>
		<field name="cumulative_sum" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="cumulative_sum"/>
			<property name="com.jaspersoft.studio.field.label" value="cumulative_sum"/>
