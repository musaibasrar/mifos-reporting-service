<!-- Created with Jaspersoft Studio version 7.0.1.final using JasperReports Library version 7.0.1-573496633c2b4074e32f433154b543003f7d2498  -->
<jasperReport name="passbook_transaction" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a11d6c3f-5db9-4f99-8b75-f178c145c3fd">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="account_no" class="java.lang.String"/>
	<parameter name="from_date" class="java.sql.Date"/>
	<query language="sql"><![CDATA[SELECT 
    DATE_FORMAT(mst.transaction_date, '%d/%m/%Y') AS txn_date,

    IFNULL(mn.note, 
        CASE 
            WHEN mst.transaction_type_enum = 1 THEN 'Deposit'
            WHEN mst.transaction_type_enum = 2 THEN 'Withdrawal'
            ELSE 'Other'
        END
    ) AS particulars,

    CASE 
        WHEN mst.transaction_type_enum = 2 THEN FORMAT(mst.amount, 2)
        ELSE '' 
    END AS withdrawal_amount,

    CASE 
        WHEN mst.transaction_type_enum = 1 THEN FORMAT(mst.amount, 2)
        ELSE '' 
    END AS deposit_amount,

    FORMAT(mst.running_balance_derived, 2) AS running_balance_derived

FROM m_savings_account_transaction mst
JOIN m_savings_account msa 
    ON msa.id = mst.savings_account_id
LEFT JOIN m_note mn 
    ON mn.savings_account_transaction_id = mst.id
   AND mn.note_type_enum = 800  

WHERE msa.account_no = $P{account_no}
  AND mst.transaction_date >= $P{from_date}

ORDER BY mst.transaction_date ASC;


]]></query>
	<field name="txn_date" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="txn_date"/>
		<property name="com.jaspersoft.studio.field.label" value="txn_date"/>
	</field>
	<field name="particulars" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="particulars"/>
		<property name="com.jaspersoft.studio.field.label" value="particulars"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="m_note"/>
	</field>
	<field name="withdrawal_amount" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="withdrawal_amount"/>
		<property name="com.jaspersoft.studio.field.label" value="withdrawal_amount"/>
	</field>
	<field name="deposit_amount" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="deposit_amount"/>
		<property name="com.jaspersoft.studio.field.label" value="deposit_amount"/>
	</field>
	<field name="running_balance_derived" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="running_balance_derived"/>
		<property name="com.jaspersoft.studio.field.label" value="running_balance_derived"/>
	</field>
