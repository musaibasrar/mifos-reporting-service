	<query language="SQL"><![CDATA[SELECT 
    CONCAT(REPEAT("..", (LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1))), ounder.name AS "Office/Branch",
    IFNULL(cur.display_symbol, l.currency_code) AS "Currency",
