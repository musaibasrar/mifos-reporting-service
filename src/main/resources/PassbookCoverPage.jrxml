<jasperReport name="passbook_cover" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b79e77e3-13ea-4cf1-802c-fff9f4c3225d">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="account_no" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
    CONCAT(mc.firstname, ' ', mc.lastname) AS fullname,
    mc.id AS client_id,
    mc.mobile_no,
    ma.address_line_1,
    ma.address_line_2,
    ma.town_village,
    ma.county_district,
    ms.account_no AS savings_account_no,
    mc.account_no AS member_no,
    mc.activation_date,
    sp.name AS scheme_name
FROM m_client mc
JOIN m_savings_account ms ON ms.client_id = mc.id
LEFT JOIN m_savings_product sp ON ms.product_id = sp.id
LEFT JOIN m_client_address mca ON mca.client_id = mc.id
LEFT JOIN m_address ma ON ma.id = mca.address_id
WHERE ms.account_no = $P{account_no}




]]></query>
