	<dataset name="SavingsBalanceDataset" uuid="22cca0ee-62e3-4e76-9200-6d5168733f1d">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<parameter name="officeId" class="java.lang.Integer"/>
		<parameter name="endDate" class="java.util.Date"/>
		<query language="SQL"><![CDATA[SELECT
OfficeName AS "Office Name", MemberName AS "Client Name", MembershipNumber AS "Client Number",
SavingsAccountNumber AS "Saving Account Number", (credit - (debit + amc)) AS balance,
SavingsProductname AS "Saving Product Number", Accountopeningdate AS "Account Opening Date", Status
FROM (
  SELECT
    msat.savings_account_id AS Accountid,
    SUM(IF(msat.transaction_type_enum = 1, amount, 0.000000)) AS credit,
    SUM(IF(msat.transaction_type_enum = 2, amount, 0.000000)) AS debit,
    SUM(IF(msat.transaction_type_enum = 5, amount, 0.000000)) AS amc,
    SUM(IF(msat.transaction_type_enum = 6, amount, 0.000000)) AS six,
    SUM(IF(msat.transaction_type_enum = 19, amount, 0.000000)) AS nine,

    CONCAT(REPEAT("..", ((LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1))), ounder.name) AS OfficeName,
    c.display_name AS MemberName,
    c.account_no AS MembershipNumber,
    sa.account_no AS SavingsAccountNumber,
    sa.account_balance_derived AS BalanceAsOn,
    sp.name AS SavingsProductname,
    sa.activatedon_date AS Accountopeningdate,
    IF(sa.status_enum = 300, 'Open', 'Closed') AS Status

  FROM
    m_office o
    JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
    JOIN m_client AS c ON c.office_id = ounder.id
    JOIN m_savings_account AS sa ON sa.client_id = c.id
    JOIN m_savings_product AS sp ON sa.product_id = sp.id
    JOIN m_savings_account_transaction AS msat ON msat.savings_account_id = sa.id
  WHERE
    o.id = $P{officeId}
    AND msat.transaction_date <= $P{endDate}
    AND msat.is_reversed = 0
  GROUP BY msat.savings_account_id
) balancereport

UNION

SELECT
OfficeName AS "Office Name", MemberName AS "Client Name", MembershipNumber AS "Client Number",
SavingsAccountNumber AS "Saving Account Number", (credit - (debit + amc)) AS balance,
SavingsProductname AS "Saving Product Number", Accountopeningdate AS "Account Opening Date", Status
FROM (
  SELECT
    msat.savings_account_id AS Accountid,
    SUM(IF(msat.transaction_type_enum = 1, amount, 0.000000)) AS credit,
    SUM(IF(msat.transaction_type_enum = 2, amount, 0.000000)) AS debit,
    SUM(IF(msat.transaction_type_enum = 5, amount, 0.000000)) AS amc,
    SUM(IF(msat.transaction_type_enum = 6, amount, 0.000000)) AS six,
    SUM(IF(msat.transaction_type_enum = 19, amount, 0.000000)) AS nine,

    CONCAT(REPEAT("..", ((LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1))), ounder.name) AS OfficeName,
    c.display_name AS MemberName,
    c.account_no AS MembershipNumber,
    sa.account_no AS SavingsAccountNumber,
    sa.account_balance_derived AS BalanceAsOn,
    sp.name AS SavingsProductname,
    sa.activatedon_date AS Accountopeningdate,
    IF(sa.status_enum = 300, 'Open', 'Closed') AS Status

  FROM
    m_office o
    JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
    JOIN m_group AS c ON c.office_id = ounder.id
    JOIN m_savings_account AS sa ON sa.group_id = c.id
    JOIN m_savings_product AS sp ON sa.product_id = sp.id
    JOIN m_savings_account_transaction AS msat ON msat.savings_account_id = sa.id
  WHERE
    o.id = $P{officeId}
    AND msat.transaction_date <= $P{endDate}
    AND msat.is_reversed = 0
  GROUP BY msat.savings_account_id
) balancereportgroup
]]></query>
