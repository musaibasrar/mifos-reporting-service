        WHERE acc_gl_journal_entry.type_enum = 2
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    RIGHT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode,
               acc_gl_account.name AS name,
               SUM(amount) AS creditamount,
               acc_gl_account.classification_enum AS type
        FROM acc_gl_journal_entry
        JOIN acc_gl_account ON acc_gl_account.id = acc_gl_journal_entry.account_id
        WHERE acc_gl_journal_entry.type_enum = 1
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode
) fullouterjoinresult
ORDER BY glcode
]]></query>
