	<dataset name="Dataset" uuid="ade81015-95da-4053-81ec-c616a7a4d371">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="startDate" class="java.sql.Date"/>
		<parameter name="endDate" class="java.sql.Date"/>
		<parameter name="officeId" class="java.lang.Integer"/>
		<query language="sql"><![CDATA[SELECT * FROM (
    SELECT debits.glcode AS glcode,
           debits.name AS name,
           IF(debits.type = 1 OR debits.type = 5,
              IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0), NULL) AS debit,
           IF(debits.type = 2 OR debits.type = 3 OR debits.type = 4,
              IFNULL(credits.creditamount,0) - IFNULL(debits.debitamount,0), NULL) AS credit
    FROM (
        SELECT acc_gl_account.gl_code AS glcode,
               acc_gl_account.name AS name,
               SUM(amount) AS debitamount,
               acc_gl_account.classification_enum AS type
        FROM acc_gl_journal_entry
        JOIN acc_gl_account ON acc_gl_account.id = acc_gl_journal_entry.account_id
        WHERE acc_gl_journal_entry.type_enum = 2
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    LEFT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode,
               acc_gl_account.name AS name,
               SUM(amount) AS creditamount,
               acc_gl_account.classification_enum AS type
        FROM acc_gl_journal_entry
        JOIN acc_gl_account ON acc_gl_account.id = acc_gl_journal_entry.account_id
        WHERE acc_gl_journal_entry.type_enum = 1
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode

    UNION

    SELECT credits.glcode AS glcode,
           credits.name AS name,
           IF(credits.type = 1 OR credits.type = 5,
              IFNULL(debits.debitamount,0) - IFNULL(credits.creditamount,0), NULL) AS debit,
           IF(credits.type = 2 OR credits.type = 3 OR credits.type = 4,
              IFNULL(credits.creditamount,0) - IFNULL(debits.debitamount,0), NULL) AS credit
    FROM (
        SELECT acc_gl_account.gl_code AS glcode,
               acc_gl_account.name AS name,
               SUM(amount) AS debitamount,
               acc_gl_account.classification_enum AS type
        FROM acc_gl_journal_entry
        JOIN acc_gl_account ON acc_gl_account.id = acc_gl_journal_entry.account_id
        WHERE acc_gl_journal_entry.type_enum = 2
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) debits
    RIGHT OUTER JOIN (
        SELECT acc_gl_account.gl_code AS glcode,
               acc_gl_account.name AS name,
               SUM(amount) AS creditamount,
               acc_gl_account.classification_enum AS type
        FROM acc_gl_journal_entry
        JOIN acc_gl_account ON acc_gl_account.id = acc_gl_journal_entry.account_id
        WHERE acc_gl_journal_entry.type_enum = 1
          AND acc_gl_journal_entry.entry_date BETWEEN $P{startDate} AND $P{endDate}
          AND (acc_gl_journal_entry.office_id = $P{officeId} OR $P{officeId} = 1)
        GROUP BY glcode
    ) credits ON debits.glcode = credits.glcode
) fullouterjoinresult
ORDER BY glcode
]]></query>
