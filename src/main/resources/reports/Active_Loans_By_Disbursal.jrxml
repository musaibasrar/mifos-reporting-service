	<dataset name="ActiveLoansDataset" uuid="ddd7696d-daf5-4007-b628-13844319492c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<parameter name="officeId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{officeId}
]]></defaultValueExpression>
		</parameter>
		<parameter name="loanProductId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{loanProductId}

]]></defaultValueExpression>
		</parameter>
		<parameter name="loanOfficerId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[$P{loanOfficerId}

]]></defaultValueExpression>
		</parameter>
		<parameter name="startDate" class="java.sql.Date">
			<defaultValueExpression><![CDATA[$P{startDate}

]]></defaultValueExpression>
		</parameter>
		<parameter name="endDate" class="java.sql.Date">
			<defaultValueExpression><![CDATA[$P{endDate}
]]></defaultValueExpression>
		</parameter>
		<query language="SQL"><![CDATA[SELECT 
    c.account_no AS "Client Account No",
    c.display_name AS "Client",
    l.account_no AS "Loan Account No",
    pl.name AS "Product",
    f.name AS "Fund",
    l.principal_amount AS "Loan Principal Amount",
    l.annual_nominal_interest_rate AS "Annual Nominal Interest Rate",
    DATE(l.disbursedon_date) AS "Disbursed Date",
    l.total_expected_repayment_derived AS "Total Loan (P+I+F+Pen)",
    l.total_repayment_derived AS "Total Repaid (P+I+F+Pen)",
    lo.display_name AS "Loan Officer"
FROM m_office o
JOIN m_client c ON c.office_id = o.id
JOIN m_loan l ON l.client_id = c.id
JOIN m_product_loan pl ON pl.id = l.product_id
LEFT JOIN m_staff lo ON lo.id = l.loan_officer_id  
LEFT JOIN m_currency cur ON cur.code = l.currency_code
LEFT JOIN m_fund f ON f.id = l.fund_id
LEFT JOIN m_loan_arrears_aging laa ON laa.loan_id = l.id
WHERE 
    o.id = $P{officeId}
    AND (l.product_id = $P{loanProductId} OR "-1" = $P{loanProductId})
    AND (IFNULL(l.loan_officer_id, -10) = $P{loanOfficerId} OR "-1" = $P{loanOfficerId})
    AND l.disbursedon_date BETWEEN $P{startDate} AND $P{endDate}
    AND l.loan_status_id = 300
GROUP BY l.id
ORDER BY l.currency_code, c.account_no, l.account_no;

]]></query>
