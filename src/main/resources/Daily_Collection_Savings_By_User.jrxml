			<property name="com.jaspersoft.studio.field.tree.path" value="m_savings_account_transaction"/>
		</field>
		<field name="Deposited By" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Deposited By"/>
			<property name="com.jaspersoft.studio.field.label" value="Deposited By"/>
		</field>
	</dataset>
	<parameter name="appUserId" class="java.lang.Integer"/>
	<parameter name="asOn" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[SELECT
CONCAT(REPEAT("..", ((LENGTH(ounder.hierarchy) - LENGTH(
REPLACE(ounder.hierarchy, '.', '')) - 1))), ounder.name) AS "Office Name",
c.display_name AS "Client Name",
sa.account_no AS "Savings Account",
sat.amount AS "Deposit Amount",
sat.transaction_date AS "Deposit Date",
sat.created_date AS "Created Date",
CONCAT(a.firstname, ' ', a.lastname) AS "Deposited By"
FROM m_office o
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
JOIN m_client AS c ON c.office_id = ounder.id
JOIN m_savings_account AS sa ON sa.client_id = c.id
RIGHT JOIN m_savings_account_transaction AS sat ON sat.savings_account_id = sa.id
JOIN m_appuser AS a ON sat.appuser_id = a.id
WHERE o.id = 1
AND a.id = $P{appUserId}
AND sat.transaction_type_enum = 1
AND sat.is_reversed = 0
AND sat.transaction_date = $P{asOn}
ORDER BY sat.created_date ASC
]]></query>
