	<dataset name="Dataset1" uuid="37ae2f70-f1d8-4c47-8a38-c30073670e8c">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mifos"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="officeId" class="java.lang.Integer"/>
		<parameter name="appUserId" class="java.lang.Integer"/>
		<parameter name="asOn" class="java.sql.Date"/>
		<query language="sql"><![CDATA[SELECT 
  totalsavings.TotalCollection AS "Total Saving Deposits", 
  totalloans.TotalCollection AS "Total Loan Repayments", 
  SUM(totalsavings.TotalCollection + totalloans.TotalCollection) AS "Total Amount", 
  $P{asOn} AS "Transaction Date"
FROM
(
  SELECT 
    'Saving', 
    COALESCE(SUM(amount), 0) AS TotalCollection, 
    '' 
  FROM
  (
    SELECT 
      '' AS 'Saving', 
      amount 
    FROM
    (
      SELECT
        sat.amount AS amount,
        sa.account_no AS ccsid
      FROM m_office o
      JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
      JOIN m_client AS c ON c.office_id = ounder.id
      JOIN m_savings_account AS sa ON sa.client_id = c.id
      JOIN m_savings_account_transaction AS sat ON sat.savings_account_id = sa.id
      JOIN m_appuser AS a ON sat.appuser_id = a.id
      WHERE o.id = $P{officeId}
        AND a.id = $P{appUserId}
        AND sat.transaction_type_enum = 1
        AND sat.is_reversed = 0
        AND sat.transaction_date = $P{asOn}
    ) AS innertbl
  ) AS outertbl
) totalsavings,
(
  SELECT 
    'Loan', 
    COALESCE(SUM(amount), 0) AS TotalCollection, 
    '' 
  FROM
  (
    SELECT 
      '' AS 'Loan', 
      amount 
    FROM
    (
      SELECT
        lt.amount AS amount,
        l.account_no AS ccsid
      FROM m_office o
      JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
      JOIN m_client AS c ON c.office_id = ounder.id
      JOIN m_loan l ON l.client_id = c.id
      JOIN m_loan_transaction lt ON lt.loan_id = l.id
      JOIN m_appuser a ON a.id = lt.appuser_id
      WHERE o.id = $P{officeId}
        AND a.id = $P{appUserId}
        AND lt.transaction_date = $P{asOn}
        AND lt.transaction_type_enum = 2
        AND lt.is_reversed = 0 
    ) AS innertbl
  ) AS outertbl
) totalloans
]]></query>
		<field name="Total Saving Deposits" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TotalCollection"/>
			<property name="com.jaspersoft.studio.field.label" value="Total Saving Deposits"/>
		</field>
		<field name="Total Loan Repayments" class="java.math.BigDecimal">
